#!/bin/sh /etc/rc.common
# Front-panel status LEDs for the Netlink HG323RGW (see /usr/bin/netlink-ledd).
# Settings: /etc/config/netlink_ledd; `/etc/init.d/netlink-ledd reload` after edits.

START=99
STOP=10
USE_PROCD=1

start_service() {
	local enabled
	config_load netlink_ledd
	config_get_bool enabled main enabled 1
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/bin/netlink-ledd
	procd_set_param respawn 3600 5 5
	procd_set_param term_timeout 12
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_trigger netlink_ledd
}
