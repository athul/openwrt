CONFIG_TARGET_realtek_luna=y
CONFIG_TARGET_realtek_luna_taroko=y
CONFIG_TARGET_realtek_luna_taroko_DEVICE_netlink_hg323rgw=y
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_PACKAGE_onu-cwmp is not set
# CONFIG_PACKAGE_gpon-provision is not set
# CONFIG_PACKAGE_luci-app-gpon is not set
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
CONFIG_TARGET_PREINIT_IP="192.168.50.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.50.255"
CONFIG_KERNEL_MTD_LUNA_NOR_WRITE=y
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-ledtrig-pattern=y
CONFIG_PACKAGE_kmod-ledtrig-activity=y
CONFIG_PACKAGE_kmod-ledtrig-oneshot=y
CONFIG_BUSYBOX_CONFIG_TIMEOUT=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-openvpn=y
CONFIG_PACKAGE_openvpn-mbedtls=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-mod-dashboard=y
